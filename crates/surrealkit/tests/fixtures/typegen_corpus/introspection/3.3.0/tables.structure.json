	"doc": {
		"events": [
			{
				"name": "on_any",
				"then": [
					"(UPDATE $after.id SET touched = true)",
					"(CREATE audit_log SET note = 'any')"
				],
				"what": "doc",
				"when": "true"
			},
			{
				"name": "on_create",
				"then": [
					"(CREATE audit_log SET doc = $after.id)"
				],
				"what": "doc",
				"when": "$event = 'CREATE'"
			},
			{
				"async": true,
				"comment": "status transitions",
				"maxdepth": 2,
				"name": "on_status",
				"retry": 3,
				"then": [
					"{ CREATE audit_log SET doc = $after.id, note = string::concat($before.status, ' -> ', $after.status) }"
				],
				"what": "doc",
				"when": "$before.status != $after.status"
			}
		],
		"fields": [
			{
				"kind": "string",

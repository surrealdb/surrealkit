//
//   const db = new Surreal() as Typed<Surreal>;
//   const [people] = await db.query("SELECT name FROM person");
//
// Declarations only: `liveQueries` is a runtime value, in `queries.js` beside this file.

import type { BoundQuery, DateTime, QueryLike, RecordId, SurrealQueryable, Uuid } from "surrealdb";

/** Every query, keyed by its exact text. */
export type Queries = {
  "SELECT name, email FROM user WHERE name = $name LIMIT $limit": { result: [Array<{ email: string; name: string }>]; params: { name: string; limit?: number } };
  "SELECT * FROM ONLY user:alice": { result: [{ bio?: string; id: RecordId<"user">; name: string } | undefined]; params: {} };
  "BEGIN; LET $n = 1; SELECT count() FROM post GROUP ALL; SELECT * FROM $__host0; COMMIT;": { result: [undefined, undefined, Array<{ count: number }>, Array<unknown>, undefined]; params: {} };
  "SELECT * FROM event": { result: [Array<{ detail: { source: string; [key: string]: unknown }; id: RecordId<"event">; kind: string; [key: string]: unknown }>]; params: {} };
  "SELECT kind FROM event": { result: [Array<{ kind: string }>]; params: {} };
  "RETURN { a: 1 }": { result: [{ a: number; [key: string]: unknown } | undefined]; params: {} };
  "SELECT * FROM post WHERE published = $published AND author = $author": { result: [Array<{ author: RecordId<"user">; title: string; when: DateTime }>]; params: { published: boolean; author: RecordId<"user"> | undefined; since?: unknown } };
  "USE NS app DB main; INFO FOR USER admin;": { result: [{ database?: string; namespace?: string }, string]; params: {} };
  "CREATE ONLY user:ada SET name = 'Ada', age = 36; UPDATE ONLY user:bob SET age += 1; DELETE user:ada; DELETE user:bob RETURN AFTER; UPDATE user SET age += 1 RETURN DIFF;": { result: [{ age: number; id: RecordId<"user">; name: string }, { age: number; id: RecordId<"user">; name: string } | undefined, [], Array<undefined>, Array<Array<{ op: "add" | "change" | "remove" | "replace"; path: string; value: unknown }>>]; params: {} };
  "SELECT * FROM user": { result: [Array<{ id: RecordId<"user">; name: string; team: RecordId<"team"> }>]; params: {} };
  "SELECT * FROM user ORDER BY name LIMIT $lim": { result: [Array<{ id: RecordId<"user">; name: string; team: RecordId<"team"> }>]; params: { lim: number } };
  "SELECT * FROM user WHERE team = $team": { result: [Array<{ id: RecordId<"user">; name: string; team: RecordId<"team"> }>]; params: { team: RecordId<"team"> } };
  "SELECT * FROM ONLY user:ada": { result: [{ id: RecordId<"user">; name: string; team: RecordId<"team"> } | undefined]; params: {} };
  "LIVE SELECT DIFF FROM user": { result: [Uuid]; params: {} };
  "LET $n = 1; LIVE SELECT * FROM user;": { result: [undefined, Uuid]; params: {} };
  "SELECT team, count() AS n FROM user GROUP BY team": { result: [Array<{ n: number; team: RecordId<"team"> }>]; params: {} };
};

/** Each named query's text, so `Queries[QueryNames["name"]]` finds its entry. */
export type QueryNames = {
  "usersByName": "SELECT name, email FROM user WHERE name = $name LIMIT $limit";
};

/** Each SELECT's live subscription facts, keyed by the same text as `Queries`. */
export declare const liveQueries: {
  readonly "SELECT * FROM user": { readonly query: "LIVE SELECT * FROM user" };
  readonly "SELECT * FROM user ORDER BY name LIMIT $lim": {
    readonly query: "LIVE SELECT * FROM user";
    readonly refusal: { readonly clauses: readonly ["ORDER BY", "LIMIT"]; readonly windowable: true };
  };
  readonly "SELECT * FROM user WHERE team = $team": { readonly query: "LIVE SELECT * FROM user WHERE team = $team"; readonly exit: "silent"; readonly watch: "LIVE SELECT id FROM user" };
  readonly "SELECT * FROM ONLY user:ada": { readonly refusal: { readonly clauses: readonly ["ONLY", "FROM"]; readonly windowable: false } };
  readonly "LIVE SELECT DIFF FROM user": { readonly query: "LIVE SELECT DIFF FROM user" };
  readonly "SELECT team, count() AS n FROM user GROUP BY team": {
    readonly query: "LIVE SELECT id FROM user";
    readonly refusal: { readonly clauses: readonly ["GROUP BY"]; readonly windowable: true };
  };
};

/** The notification a live subscription delivers, per query, as the SDK's `LiveMessage` carries it. */
type LiveNotifications = {
  "SELECT * FROM user": { queryId: Uuid; action: "CREATE"; recordId: RecordId<"user">; value: { id: RecordId<"user">; name: string; team: RecordId<"team"> } } | { queryId: Uuid; action: "UPDATE"; recordId: RecordId<"user">; value: { id: RecordId<"user">; name: string; team: RecordId<"team"> } } | { queryId: Uuid; action: "DELETE"; recordId: RecordId<"user">; value: { id: RecordId<"user">; name: string; team: RecordId<"team"> } } | { queryId: Uuid; action: "KILLED"; recordId?: undefined; value?: undefined };
  "SELECT * FROM user ORDER BY name LIMIT $lim": { queryId: Uuid; action: "CREATE"; recordId: RecordId<"user">; value: { id: RecordId<"user">; name: string; team: RecordId<"team"> } } | { queryId: Uuid; action: "UPDATE"; recordId: RecordId<"user">; value: { id: RecordId<"user">; name: string; team: RecordId<"team"> } } | { queryId: Uuid; action: "DELETE"; recordId: RecordId<"user">; value: { id: RecordId<"user">; name: string; team: RecordId<"team"> } } | { queryId: Uuid; action: "KILLED"; recordId?: undefined; value?: undefined };
  "SELECT * FROM user WHERE team = $team": { queryId: Uuid; action: "CREATE"; recordId: RecordId<"user">; value: { id: RecordId<"user">; name: string; team: RecordId<"team"> } } | { queryId: Uuid; action: "UPDATE"; recordId: RecordId<"user">; value: { id: RecordId<"user">; name: string; team: RecordId<"team"> } } | { queryId: Uuid; action: "DELETE"; recordId: RecordId<"user">; value: { id: RecordId<"user">; name: string; team: RecordId<"team"> } } | { queryId: Uuid; action: "KILLED"; recordId?: undefined; value?: undefined };
  "LIVE SELECT DIFF FROM user": { queryId: Uuid; action: "CREATE"; recordId: RecordId<"user">; value: Array<{ op: "add" | "change" | "remove" | "replace"; path: string; value: unknown }> } | { queryId: Uuid; action: "UPDATE"; recordId: RecordId<"user">; value: Array<{ op: "add" | "change" | "remove" | "replace"; path: string; value: unknown }> } | { queryId: Uuid; action: "DELETE"; recordId: RecordId<"user">; value: Array<{ op: "add" | "change" | "remove" | "replace"; path: string; value: unknown }> } | { queryId: Uuid; action: "KILLED"; recordId?: undefined; value?: undefined };
  "SELECT team, count() AS n FROM user GROUP BY team": { queryId: Uuid; action: "CREATE"; recordId: RecordId<"user">; value: { id: RecordId<"user"> } } | { queryId: Uuid; action: "UPDATE"; recordId: RecordId<"user">; value: { id: RecordId<"user"> } } | { queryId: Uuid; action: "DELETE"; recordId: RecordId<"user">; value: { id: RecordId<"user"> } } | { queryId: Uuid; action: "KILLED"; recordId?: undefined; value?: undefined };
};
export type LiveQueries = {
  [K in keyof typeof liveQueries]: (typeof liveQueries)[K] & {
    notification: K extends keyof LiveNotifications ? LiveNotifications[K] : never;
  };
};
/** The texts a live subscription can serve: every entry but a refusal LIVE cannot window. */
export type LiveQueryText = {
  [K in keyof LiveQueries]: LiveQueries[K] extends { refusal: { windowable: false } } ? never : K;
}[keyof LiveQueries];
export type LiveNotification<K extends LiveQueryText> = LiveQueries[K]["notification"];

declare const queryable: SurrealQueryable;
/** The SDK's `Query<R>`, which it does not export by name. */
export type QueryOf<R extends unknown[]> = ReturnType<typeof queryable.query<R>>;
type ParamsOf<K extends keyof Queries> = Queries[K]["params"];
/** A query that reads no parameter takes no bindings; one whose parameters are all optional may omit them. */
type BindingsArg<K extends keyof Queries> = [keyof ParamsOf<K>] extends [never]
  ? [bindings?: Record<string, never>]
  : {} extends ParamsOf<K>
    ? [bindings?: ParamsOf<K>]
    : [bindings: ParamsOf<K>];
/** Query text that is not a key of `Queries`; a known text is `never`, so it cannot reach the untyped overload. */
type UnknownText<S extends string> = S extends keyof Queries ? never : S;
/**
 * `query()` typed by exact query text: a known text gets the registry's result type and must be
 * given its parameters' types. Any other text, and the SDK's other forms, keep the SDK's own types.
 */
export interface TypedQueryable {
  query<K extends keyof Queries>(query: K, ...bindings: BindingsArg<K>): QueryOf<Queries[K]["result"]>;
  query<R extends unknown[] = unknown[], S extends string = string>(
    query: UnknownText<S>,
    bindings?: Record<string, unknown>,
  ): QueryOf<R>;
  query<R extends unknown[] = unknown[]>(query: BoundQuery<R>): QueryOf<R>;
  query<R extends unknown[] = unknown[]>(queries: readonly QueryLike[]): QueryOf<R>;
}
/** A client whose `query()` returns the registry's result type for known query text. */
export type Typed<T extends SurrealQueryable> = Omit<T, "query"> & TypedQueryable;

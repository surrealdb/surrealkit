// Generated by SurrealKit — do not edit.
// Run `surrealkit typegen` to regenerate.

import type { Decimal, Duration, GeometryPoint, GeometryPolygon, RecordId, Uuid } from 'surrealdb';

export interface Thing {
  id: RecordId<'thing'>;
  a: any;
  arr: number[];
  arr_n: string[];
  b: boolean;
  bs: Uint8Array;
  code: 200 | 404;
  d: Decimal;
  dt: Date;
  du: Duration;
  f: number;
  flag: true | false;
  geo: GeometryPoint | GeometryPolygon;
  guarded: string;
  i: number;
  items: ({
    label: string;
  })[];
  n: number;
  nested: {
    inner: {
      leaf?: number;
    };
  };
  nul: string | null;
  o: { [key: string]: unknown };
  opt?: string;
  rec: RecordId<'user'>;
  recs?: (RecordId<'user'> | RecordId<'thing'>)[];
  s: string;
  st: string[];
  status: "open" | "closed";
  u: Uuid;
  untyped: unknown;
}

export interface User {
  id: RecordId<'user'>;
  name: string;
}

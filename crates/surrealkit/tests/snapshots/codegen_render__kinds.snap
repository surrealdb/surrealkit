// Generated by SurrealKit: the result type of each query. Do not edit.
// Source: the `queries` section of schema document v2.
//
// Type a client's `query()` by exact query text:
//
//   const db = new Surreal() as Typed<Surreal>;
//   const [people] = await db.query("SELECT name FROM person");

import type { BoundQuery, DateTime, Decimal, Duration, FileRef, Geometry, GeometryCollection, GeometryLine, GeometryMultiLine, GeometryMultiPoint, GeometryMultiPolygon, GeometryPoint, GeometryPolygon, QueryLike, Range, RecordId, SurrealQueryable, Table, Uuid } from "surrealdb";

/** Every query, keyed by its exact text. */
export type Queries = {
  "RETURN scalars": { result: [unknown, undefined, null, boolean, number, number, Decimal, number, string, DateTime, Duration, Uuid, Uint8Array, unknown, Range<unknown, unknown>, unknown, { [key: string]: unknown }]; params: {} };
  "RETURN refs": { result: [RecordId, RecordId<"a" | "b">, Table, Table<"a" | "b">, FileRef, FileRef]; params: {} };
  "RETURN geometry": { result: [Geometry, GeometryPoint, GeometryCollection | GeometryLine | GeometryMultiLine | GeometryMultiPoint | GeometryMultiPolygon | GeometryPoint | GeometryPolygon]; params: {} };
  "RETURN collections": { result: [Array<string>, Array<number>, Set<Uuid>, [number, string, boolean | undefined], [], Array<string | undefined>]; params: {} };
  "RETURN literals": { result: ["draft", "say \"hi\"", 42, 1.5, Decimal, Duration, true, false]; params: {} };
  "RETURN objects": { result: [{ name: string; nick?: string; "weird key": number; nested: { deep?: null } }, {}]; params: {} };
  "RETURN options and unions": { result: [string | undefined, number | string, number, "draft" | "live", string | undefined, null | Uuid | undefined, undefined, unknown]; params: {} };
  "RETURN sized": { result: [number, number, number, unknown, unknown, unknown, unknown, unknown, "low" | "high", Decimal, { children: Array<unknown>; label: string }, unknown]; params: {} };
};

/** Each named query's text, so `Queries[QueryNames["name"]]` finds its entry. */
export type QueryNames = {
  "scalars": "RETURN scalars";
  "refs": "RETURN refs";
  "geometry": "RETURN geometry";
  "collections": "RETURN collections";
  "literals": "RETURN literals";
  "objects": "RETURN objects";
  "options_and_unions": "RETURN options and unions";
  "sized": "RETURN sized";
};

declare const queryable: SurrealQueryable;
/** The SDK's `Query<R>`, which it does not export by name. */
export type QueryOf<R extends unknown[]> = ReturnType<typeof queryable.query<R>>;
type ParamsOf<K extends keyof Queries> = Queries[K]["params"];
/** A query that reads no parameter takes no bindings; one whose parameters are all optional may omit them. */
type BindingsArg<K extends keyof Queries> = [keyof ParamsOf<K>] extends [never]
  ? [bindings?: Record<string, never>]
  : {} extends ParamsOf<K>
    ? [bindings?: ParamsOf<K>]
    : [bindings: ParamsOf<K>];
/** Query text that is not a key of `Queries`; a known text is `never`, so it cannot reach the untyped overload. */
type UnknownText<S extends string> = S extends keyof Queries ? never : S;
/**
 * `query()` typed by exact query text: a known text gets the registry's result type and must be
 * given its parameters' types. Any other text, and the SDK's other forms, keep the SDK's own types.
 */
export interface TypedQueryable {
  query<K extends keyof Queries>(query: K, ...bindings: BindingsArg<K>): QueryOf<Queries[K]["result"]>;
  query<R extends unknown[] = unknown[], S extends string = string>(
    query: UnknownText<S>,
    bindings?: Record<string, unknown>,
  ): QueryOf<R>;
  query<R extends unknown[] = unknown[]>(query: BoundQuery<R>): QueryOf<R>;
  query<R extends unknown[] = unknown[]>(queries: readonly QueryLike[]): QueryOf<R>;
}
/** A client whose `query()` returns the registry's result type for known query text. */
export type Typed<T extends SurrealQueryable> = Omit<T, "query"> & TypedQueryable;

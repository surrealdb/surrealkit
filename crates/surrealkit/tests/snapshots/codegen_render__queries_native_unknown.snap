// Generated by SurrealKit: the result type of each query. Do not edit.
// Source: the `queries` section of schema document v2.
//
// Type a client's `query()` by exact query text:
//
//   const db = new Surreal() as Typed<Surreal>;
//   const [people] = await db.query("SELECT name FROM person");

import type { RecordId, SurrealQueryable } from "surrealdb";

/** Every query, keyed by its exact text. */
export type Queries = {
  "SELECT name, email FROM user WHERE name = $name LIMIT $limit": { result: [Array<{ email: string; name: string }>]; params: { name: string; limit?: number } };
  "SELECT * FROM ONLY user:alice": { result: [{ bio?: string; id: RecordId<"user">; name: string } | undefined]; params: {} };
  "BEGIN; LET $n = 1; SELECT count() FROM post GROUP ALL; SELECT * FROM $__host0; COMMIT;": { result: [undefined, undefined, Array<{ count: number }>, unknown, undefined]; params: {} };
  "SELECT * FROM event": { result: [unknown]; params: {} };
  "SELECT kind FROM event": { result: [Array<{ kind: string }>]; params: {} };
  "RETURN { a: 1 }": { result: [{ a: number; [key: string]: unknown } | undefined]; params: {} };
  "SELECT * FROM post WHERE published = $published AND author = $author": { result: [Array<{ author: RecordId<"user">; title: string; when: Date }>]; params: { published: boolean; author: RecordId<"user"> | undefined; since?: unknown } };
  "USE NS app DB main; INFO FOR USER admin;": { result: [{ database?: string; namespace?: string }, string]; params: {} };
};

/** Each named query's text, so `Queries[QueryNames["name"]]` finds its entry. */
export type QueryNames = {
  "usersByName": "SELECT name, email FROM user WHERE name = $name LIMIT $limit";
};

declare const queryable: SurrealQueryable;
/** The SDK's `Query<R>`, which it does not export by name. */
export type QueryOf<R extends unknown[]> = ReturnType<typeof queryable.query<R>>;
type BindingsArg<K extends keyof Queries> = {} extends Queries[K]["params"]
  ? [bindings?: Queries[K]["params"]]
  : [bindings: Queries[K]["params"]];
/** `query()` typed by exact query text; other text falls through to the SDK's own overloads. */
export interface TypedQueryable {
  query<K extends keyof Queries>(query: K, ...bindings: BindingsArg<K>): QueryOf<Queries[K]["result"]>;
}
/** A client whose `query()` returns the registry's result type for known query text. */
export type Typed<T extends SurrealQueryable> = TypedQueryable & T;

def _validated(text: str, result: Sequence[object]) -> tuple[object, ...]:
    adapters = _ADAPTERS.get(text)
    if adapters is None:
        return tuple(result)
    return tuple(adapter.validate_python(item) for adapter, item in zip(adapters, result))



{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM"],
		"jsx": "react-jsx",
		"strict": true,
		"exactOptionalPropertyTypes": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"verbatimModuleSyntax": true,
		"declaration": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["node"],
		"paths": { "surrealkit-query": ["../surrealkit-query/src/index.ts"] }
	},
	"include": ["src/**/*", "test/**/*", "vitest.config.ts", "tsup.config.ts"],
	"exclude": ["test/types"]
}

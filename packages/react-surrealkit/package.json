{
	"name": "react-surrealkit",
	"version": "0.1.0",
	"description": "React and Next.js bindings for SurrealKit's typed queries: useQuery, useLive and Server Component payloads",
	"license": "Apache-2.0",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"import": "./dist/server.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"sideEffects": false,
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"scripts": {
		"build": "rm -rf dist && tsup",
		"clean": "rm -rf dist",
		"format": "biome check --write .",
		"lint": "biome ci .",
		"test": "vitest run",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test/types"
	},
	"keywords": [
		"react",
		"nextjs",
		"hooks",
		"surrealdb",
		"surrealkit",
		"live-query"
	],
	"dependencies": {
		"surrealkit-query": "file:../surrealkit-query"
	},
	"peerDependencies": {
		"react": "^18.3.0 || ^19.0.0",
		"surrealdb": "^2.1.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^24.3.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"jsdom": "^26.1.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"surrealdb": "2.1.1",
		"tsup": "^8.2.4",
		"typescript": "^5.9.2",
		"vitest": "^3.2.4"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/surrealdb/surrealkit.git",
		"directory": "packages/react-surrealkit"
	},
	"homepage": "https://github.com/surrealdb/surrealkit/tree/main/packages/react-surrealkit#readme",
	"bugs": {
		"url": "https://github.com/surrealdb/surrealkit/issues"
	},
	"publishConfig": {
		"access": "public"
	}
}

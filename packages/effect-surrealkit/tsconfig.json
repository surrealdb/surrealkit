{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": [
			"ES2022"
		],
		"strict": true,
		"exactOptionalPropertyTypes": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"verbatimModuleSyntax": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"skipLibCheck": true,
		"outDir": "dist",
		"types": [
			"node"
		],
		"paths": {
			"effect-surrealkit": [
				"./src/index.ts"
			]
		}
	},
	"include": [
		"src/**/*.ts",
		"test/**/*.ts",
		"vitest.config.ts"
	],
	"exclude": [
		"test/golden",
		"test/types"
	]
}

{
	"compilerOptions": {
		"target": "ES2022",
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"lib": ["ES2022"],
		"types": [],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"contentMappers": [
		{
			"package": "effect-surrealkit",
			"extensions": [".surql"],
			"options": { "input": "queries" }
		}
	],
	"include": ["queries"]
}

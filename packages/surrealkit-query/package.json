{
	"name": "surrealkit-query",
	"version": "0.1.0",
	"description": "The framework-agnostic core of SurrealKit's typed queries: a shared cache, live queries with a managed lifecycle, and SSR payloads",
	"license": "Apache-2.0",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"sideEffects": false,
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"scripts": {
		"build": "rm -rf dist && tsup",
		"clean": "rm -rf dist",
		"format": "biome check --write .",
		"prepare": "tsup",
		"lint": "biome ci .",
		"test": "vitest run",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test/types && tsc --noEmit -p test/types-strict && tsc --noEmit -p test/types-live && tsc --noEmit -p test/types-generated"
	},
	"keywords": [
		"surrealdb",
		"surrealkit",
		"live-query",
		"cache"
	],
	"peerDependencies": {
		"surrealdb": "^2.1.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.2",
		"@types/node": "^24.3.0",
		"surrealdb": "2.1.1",
		"tsup": "^8.2.4",
		"typescript": "^5.9.2",
		"vitest": "^3.2.4"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/surrealdb/surrealkit.git",
		"directory": "packages/surrealkit-query"
	},
	"homepage": "https://github.com/surrealdb/surrealkit/tree/main/packages/surrealkit-query#readme",
	"bugs": {
		"url": "https://github.com/surrealdb/surrealkit/issues"
	},
	"publishConfig": {
		"access": "public"
	}
}

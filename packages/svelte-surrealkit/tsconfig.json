{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": [
			"ES2022",
			"DOM"
		],
		"strict": true,
		"exactOptionalPropertyTypes": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noEmit": true,
		"paths": {
			"surrealkit-query": [
				"../surrealkit-query/src/index.ts"
			]
		},
		"types": [
			"node"
		]
	},
	"include": [
		"src/**/*",
		"test/**/*"
	],
	"exclude": [
		"test/types"
	]
}

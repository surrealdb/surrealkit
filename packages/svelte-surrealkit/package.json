{
	"name": "svelte-surrealkit",
	"version": "0.1.0",
	"description": "Svelte 5 and SvelteKit bindings for SurrealKit's typed queries: <Query>, <LiveQuery>, createQuery and createLive",
	"license": "Apache-2.0",
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"sideEffects": false,
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"scripts": {
		"build": "rm -rf dist && svelte-package --input src --output dist",
		"clean": "rm -rf dist",
		"format": "biome check --write .",
		"lint": "biome ci .",
		"test": "vitest run",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && node test/types/golden.mjs"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"runes",
		"surrealdb",
		"surrealkit",
		"live-query"
	],
	"dependencies": {
		"surrealkit-query": "file:../surrealkit-query"
	},
	"peerDependencies": {
		"svelte": "^5.7.0",
		"surrealdb": "^2.1.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.2",
		"@sveltejs/package": "^2.5.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^24.3.0",
		"jsdom": "^26.1.0",
		"surrealdb": "2.1.1",
		"svelte": "^5.43.0",
		"svelte-check": "^4.3.0",
		"typescript": "^5.9.2",
		"vite": "^7.3.0",
		"vitest": "^3.2.4"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/surrealdb/surrealkit.git",
		"directory": "packages/svelte-surrealkit"
	},
	"homepage": "https://github.com/surrealdb/surrealkit/tree/main/packages/svelte-surrealkit#readme",
	"bugs": {
		"url": "https://github.com/surrealdb/surrealkit/issues"
	},
	"publishConfig": {
		"access": "public"
	}
}

{
	"name": "surrealkit-example-vue-live",
	"private": true,
	"type": "module",
	"description": "vue-surrealkit in a Vite + Vue 3 app: live queries, a search, and writes from server routes",
	"scripts": {
		"db": "surreal start --user root --pass root --allow-guests --bind 127.0.0.1:8000 memory",
		"seed": "node scripts/seed.mjs",
		"types": "${SURREALKIT_BIN:-surrealkit} compile",
		"types:check": "${SURREALKIT_BIN:-surrealkit} compile --check",
		"typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview"
	},
	"dependencies": {
		"surrealdb": "2.1.1",
		"surrealkit-query": "file:../../packages/surrealkit-query",
		"vue": "3.5.45",
		"vue-surrealkit": "file:../../packages/vue-surrealkit"
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"@vitejs/plugin-vue": "^6.0.10",
		"typescript": "^5.9.3",
		"vite": "^7.3.0",
		"vue-tsc": "^3.3.14"
	}
}

SURREALDB_HOST=
SURREALDB_NAME=
SURREALDB_NAMESPACE=
SURREALDB_USER=
SURREALDB_PASSWORD=
SURREALDB_FOLDER=

# Seconds to wait for the connection and sign-in. Defaults to 30; 0 waits
# indefinitely, which is how every release through 1.0.0-beta.1 behaved.
SURREALDB_CONNECT_TIMEOUT_SECS=
# Seconds to wait for a single rollout step's SQL. Unset waits indefinitely,
# because an index build can legitimately take hours.
SURREALDB_QUERY_TIMEOUT_SECS=
